#!/bin/bash -e
ELB_HOSTNAMES="{{ openvpn.push_routes_elb | join(' ') }}"
TMP=$(mktemp)

for h in $ELB_HOSTNAMES; do
  host -t A "$h" 1.1.1.1 | awk '/has address/ { print "push \"route "$NF" 255.255.255.255\"" }'
done | sort -u > "$TMP" 

if ! cmp -s "$TMP" /etc/openvpn/elb-routes.inc; then
  mv "$TMP" /etc/openvpn/elb-routes.inc
  systemctl reload openvpn.service
else
  rm "$TMP"
fi
